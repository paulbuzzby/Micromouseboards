	)
	(text_box "R6, R8, R16 and R23 control how much current goes through the constant current system.\n4R7 is a starting value.\nCalculation is I = 0.6 / R\nfor 0.6/4R7 = 128mA"
		(exclude_from_sim no)
		(at 87.63 144.78 0)
		(size 31.75 10.16)
		(margins 0.6668 0.6668 0.6668 0.6668)
